// Hunt 02 - Scattered Invoice | Stage 2: Persistence (CloudAppEvents)

// 2a. Inbox rule parameters, one row per parameter
CloudAppEvents
| where Timestamp between (datetime(2026-02-25T21:00:00Z) .. datetime(2026-02-26T00:00:00Z))
| where ActionType == "New-InboxRule" and IPAddress == "205.147.16.190"
| mv-expand Param = parse_json(RawEventData).Parameters
| where Param.Name in ("Name", "ForwardTo", "SubjectOrBodyContainsWords", "DeleteMessage", "StopProcessingRules")
| project Timestamp, Parameter = tostring(Param.Name), Value = tostring(Param.Value)

// 2b. All rule changes in the window (no IP filter) + seconds between them
CloudAppEvents
| where Timestamp between (datetime(2026-02-25T21:00:00Z) .. datetime(2026-02-26T00:00:00Z))
| where ActionType in ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules")
| order by Timestamp asc
| serialize
| extend SecondsSincePrev = datetime_diff('second', Timestamp, prev(Timestamp))
| project Timestamp, IPAddress, ActionType, SecondsSincePrev

// 2c. Tenant-wide: any other mailbox forwarding to the attacker address
CloudAppEvents
| where ActionType in ("New-InboxRule", "Set-InboxRule", "Set-Mailbox")
| where RawEventData has "insights@duck.com"
| project Timestamp, AccountId, IPAddress, ActionType
