// Hunt 02 - Scattered Invoice | Stage 4: Blast radius (CloudAppEvents)

// 4a. Everything the attacker IP did, in order
CloudAppEvents
| where Timestamp between (datetime(2026-02-25T21:00:00Z) .. datetime(2026-02-26T00:00:00Z))
| where IPAddress == "205.147.16.190"
| summarize Count=count(), First=min(Timestamp) by ActionType, Application
| order by First asc

// 4b. File access detail
CloudAppEvents
| where Timestamp between (datetime(2026-02-25T21:00:00Z) .. datetime(2026-02-26T00:00:00Z))
| where IPAddress == "205.147.16.190"
| where ActionType has "File"
| project Timestamp, ActionType, Application, ObjectName,
          FileName = tostring(parse_json(RawEventData).SourceFileName),
          SiteUrl = tostring(parse_json(RawEventData).SiteUrl)
